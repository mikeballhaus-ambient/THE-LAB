{
  "name": "the-lab",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "back-end": "tsx src/backend-entry.ts",
    "pre-bootstrap": "tsx src/scripts/sync-app-dirs.ts",
    "verify:app-dirs": "tsx src/scripts/sync-app-dirs.ts",
    "bootstrap": "npm run pre-bootstrap && concurrently \"npm run chroma\" \"vite\" \"npm run back-end\"",
    "build": "vite build",
    "build-check": "npm run build -- --logLevel error",
    "chroma": "chroma run --host 127.0.0.1 --port 8000 --path ./chroma-data",
    "dev": "npm run bootstrap",
    "front-end": "vite",
    "generate:app": "tsx src/scripts/generate-app.ts",
    "lab": "tsx src/scripts/lab-stack.ts start",
    "lab:start": "tsx src/scripts/lab-stack.ts start",
    "lab:stop": "tsx src/scripts/lab-stack.ts stop",
    "lab:services": "tsx src/scripts/lab-stack.ts start --services-only --detach --wait-ready",
    "metrics:baseline": "tsx src/scripts/metrics-baseline.ts",
    "metrics:phase2-verify": "tsx src/scripts/metrics-phase-2-verify.ts",
    "kb-rag:reindex": "tsx --env-file=.env src/scripts/kb-rag-reindex.ts",
    "kb-rag:probe": "tsx --env-file=.env src/scripts/kb-rag-probe-query.ts",
    "backup:lab": "node scripts/backup-lab-data.mjs",
    "backup:verify-sandbox": "node scripts/backup-restore-verify-sandbox.mjs",
    "kill:app-servers": "tsx src/scripts/kill-all-app-servers.ts",
    "kill:app-servers:list": "tsx src/scripts/kill-all-app-servers.ts --list",
    "restart:app-server": "tsx src/scripts/restart-app-server.ts",
    "persona-tools-loader": "tsx --env-file=.env src/scripts/persona-tools-loader/persona-tools-config.ts",
    "lint": "npx eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx",
    "lint:ci": "node scripts/lint-ci.mjs",
    "lint-file": "node scripts/lint-file.js",
    "preview": "vite preview",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=/src/tests/ci/",
    "test:pipeline": "npm run lint && npm run type-check && npm run verify:test-tiers && npm run verify:domain-event-manifests && npm run test:ci && npm run build",
    "test:regression": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "verify:test-tiers": "node scripts/verify-test-tiers.mjs",
    "verify:test-tiers:report": "node scripts/report-test-tiers.mjs",
    "test:name": "node --experimental-vm-modules scripts/run-test-by-name.js",
    "test:path": "node --experimental-vm-modules scripts/run-test-by-path.js",
    "test:smoke": "node scripts/run-smoke.mjs",
    "test:e2e:install": "playwright install --with-deps chromium",
    "type-check-ts": "npx tsc --noEmit",
    "type-check-ts:ci": "npx tsc --noEmit -p tsconfig.ci.json",
    "type-check-vue": "vue-tsc --noEmit --skipLibCheck",
    "type-check-vue:ci": "vue-tsc --noEmit --skipLibCheck -p tsconfig.ci.json",
    "type-check": "npm run type-check-ts && concurrently \"npm run type-check-vue\"",
    "type-check:ci": "npm run type-check-ts:ci && npm run type-check-vue:ci",
    "type-check-file": "node scripts/type-check-file.js",
    "export:demo-workflows": "tsx src/scripts/export-demo-workflows.ts",
    "apply:demo-workflow-seeds": "tsx src/scripts/apply-demo-workflow-seeds-from-db.ts",
    "export:integration-seeds": "tsx src/scripts/export-integration-seeds.ts",
    "export:integration-app-dbs": "tsx src/scripts/export-integration-app-dbs.ts",
    "verify:integration-seeds": "tsx src/scripts/verify-integration-seeds.ts",
    "verify:seed-copy": "tsx src/scripts/verify-seed-roadmap-ids.ts",
    "verify:theme-colors": "tsx src/scripts/verify-theme-colors.ts",
    "verify:record-automation": "tsx src/scripts/verify-lab-record-automation.ts",
    "backfill:integration-stub-copy": "tsx src/scripts/backfill-integration-stub-descriptions.ts",
    "verify:integration-connectors": "tsx src/scripts/verify-integration-connector-routes.ts",
    "verify:domain-event-manifests": "tsx src/scripts/verify-domain-event-manifests.ts",
    "audit:vue-styles": "tsx src/scripts/audit-vue-style-blocks.ts",
    "verify-handoff-path": "node scripts/verify-handoff-path.mjs",
    "verify-lint-phase": "node scripts/verify-lint-phase.mjs",
    "regenerate-lint-phases": "node scripts/generate-lint-inventory.mjs && node scripts/generate-lint-phase-manifests.mjs && node scripts/generate-lint-phase-docs.mjs"
  },
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@chroma-core/default-embed": "^0.1.9",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^8.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@primevue/themes": "^4.5.4",
    "@tailwindcss/postcss": "^4.2.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^25.3.0",
    "@vue-dnd-kit/core": "^2.2.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue/compiler-sfc": "^3.5.28",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "11.1.2",
    "browserify-fs": "^1.0.0",
    "chart.js": "^4.4.0",
    "chartjs-chart-funnel": "^4.2.5",
    "chartjs-plugin-datalabels": "^2.2.0",
    "chromadb": "^3.3.1",
    "codemirror": "^6.0.2",
    "dexie": "^4.4.2",
    "dompurify": "^3.3.1",
    "dotenv": "^17.4.2",
    "fastify": "^4.29.1",
    "jq": "^1.7.2",
    "leaflet": "^1.9.4",
    "luxon": "^3.7.2",
    "marked": "^17.0.6",
    "micromark": "^4.0.2",
    "motion-v": "^2.2.0",
    "music-metadata": "^11.12.3",
    "ollama": "^0.6.3",
    "openai": "^6.33.0",
    "ora": "^9.4.0",
    "pinia": "^4.0.3",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "quill": "^2.0.3",
    "rrule": "^2.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.187.0",
    "uuid": "^14.0.2",
    "vue": "^3.5.28",
    "wavesurfer.js": "^7.12.7",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@babel/types": "^7.29.0",
    "@playwright/test": "^1.64.1",
    "@types/babel__parser": "^7.0.0",
    "@types/babel__traverse": "^7.0.28",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/luxon": "^3.7.6",
    "@types/mime-types": "^3.0.1",
    "@types/three": "^0.187.0",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.109.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@volar/language-server": "^2.4.28",
    "@volar/typescript": "^2.4.28",
    "@volar/vue-language-server": "^1.6.5",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.8.1",
    "@vue/typescript-plugin": "^3.3.2",
    "@vueuse/core": "^14.2.1",
    "autoprefixer": "^10.4.24",
    "buffer": "^6.0.3",
    "concurrently": "^8.2.2",
    "eslint": "^10.0.1",
    "eslint-plugin-vue": "^10.8.0",
    "jest": "^30.3.0",
    "json-schema-to-ts": "^3.1.1",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.2.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tstyche": "^5.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-svg-loader": "^5.1.1",
    "vscode": "^1.1.37",
    "vue-tsc": "^3.2.5",
    "vuex": "^4.0.2"
  }
}
