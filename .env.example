# Copy to `.env` in the repo root (`.env` is gitignored).
# Loaded by backend (`src/backend-entry.ts`) and Vite.

# --- Vite / dashboard (browser) ---
VITE_API_BASE_URL=http://localhost
VITE_API_BASE_PORT=3000
# Quarks hint UI — dev mock purchase button on catalog games (default on in Vite dev; set 0 to hide)
# VITE_LAB_GAME_HINT_DEV_MOCK=0
VITE_CHROMA_URL=localhost
VITE_LOGGING_ENABLED=1

# --- Optional MCP integrations ---
# VITE_CONTEXT7_BASEURL=https://context7.com/api/v2/
# VITE_CONTEXT7_KEY=
# VITE_WEB_QUERY_BASEURL=
# VITE_WEB_QUERY_API_KEY=

# --- Chroma process (required on Windows x64 — npm's chromadb CLI does not support this platform) ---
THE_LAB_CHROMA_BIN=C:\Users\YOU\AppData\Local\Programs\Python\Python312\Scripts\chroma.exe

# --- Weather Dashboard (app-weather-dashboard hybrid server) ---
# Free key: https://openweathermap.org/api — enables OWM tile overlays + map click weather probe.
# OPENWEATHERMAP_API_KEY=

# --- App servers (hybrid/server warm-up on main backend start; default on) ---
# LAB_APP_SERVER_WARMUP=0

# --- Platform URLs (optional) ---
# BACKEND_URL=http://localhost:3000
# THE_LAB_BACKEND_URL=http://localhost:3000
LAB_FRONTEND_URL=http://localhost:5173
# DATABASE_PATH=db/the_lab.db
# LOG_OUTPUT_PATH=logs

# --- Production / auth (rm-46 Phase 1) ---
# LAB_PRODUCTION_PROFILE=1
# App server: allow hint purchase route to skip ledger when testing (never with LAB_PRODUCTION_PROFILE=1)
# LAB_GAME_HINT_DEV_MOCK=1
# LAB_ALLOWED_ORIGINS=http://localhost:5173
# LAB_JWT_SECRET=
# LAB_APP_SERVICE_TOKEN=set-a-long-random-secret-in-real-deploys
# REQUIRE_ADMIN_PASSWORD_RESET=1
# LAB_PERSONA_DIRECT_WORKFLOW=1

# --- Google OIDC (on backend boot, copies into SQLite when that provider has no client id/secret yet) ---
# OAuth 2.0 "Web application" in Google Cloud Console. Callback must match redirect URI.
# LAB_GOOGLE_OIDC_CLIENT_ID=
# LAB_GOOGLE_OIDC_CLIENT_SECRET=
# LAB_GOOGLE_OIDC_REDIRECT_URI=http://localhost:3000/auth/oidc/google/callback

# --- GitHub OAuth (same boot-time seed into SQLite when the row has no credentials) ---
# GitHub → Developer settings → OAuth Apps. Callback must match redirect URI.
# LAB_GITHUB_OIDC_CLIENT_ID=
# LAB_GITHUB_OIDC_CLIENT_SECRET=
# LAB_GITHUB_OIDC_REDIRECT_URI=http://localhost:3000/auth/oidc/github/callback

# --- Microsoft Entra ID OIDC (same boot-time seed; TENANT_ID optional, defaults to common) ---
# Azure Portal → App registrations. Web redirect URI must match.
# LAB_MICROSOFT_ENTRA_OIDC_CLIENT_ID=
# LAB_MICROSOFT_ENTRA_OIDC_CLIENT_SECRET=
# LAB_MICROSOFT_ENTRA_OIDC_TENANT_ID=common
# LAB_MICROSOFT_ENTRA_OIDC_REDIRECT_URI=http://localhost:3000/auth/oidc/microsoft-entra/callback

# --- KB document RAG (kb-chunks collection; Phase 2) ---
# Index ingest on publish + startup reconcile are on unless set to 0.
# LAB_KB_RAG_INGEST_ON_PUBLISH=0
# LAB_KB_RAG_STARTUP_RECONCILE=0
# User id for embed on reindex / hybrid / slot A when not the chat user (default 1).
# LAB_KB_RAG_EMBED_USER_ID=1
# Slot A: append retrieved KB chunks to chat system prompt (embed + Chroma per turn).
LAB_KB_RAG_SLOT_A=1
# Slot C: vector leg merged into lab_kb_search (embed + Chroma on tool calls).
LAB_KB_RAG_HYBRID_SEARCH=1
# JSON kb_rag_preinject when slot A runs (also enables platform structured logs; comment out if noisy).
LAB_STRUCTURED_LOGS=1
# LAB_KB_RAG_TOP_K=3
# LAB_KB_RAG_MIN_SCORE=0.15
# LAB_KB_RAG_MIN_QUERY_CHARS=8
# LAB_KB_RAG_MAX_APPENDIX_CHARS=4000

# --- Chroma retrieval caps (Phase 2.3) ---
# LAB_CHROMA_SESSION_NRESULTS=120
# LAB_CHROMA_SESSION_FETCH_LIMIT=250
# LAB_CHROMA_SUMMARY_NRESULTS=8
# LAB_CHROMA_SUMMARY_MAX=50
# LAB_CHROMA_SESSION_DELETE_LIMIT=2000

# --- Chroma write / degraded mode (Phase 2.4) ---
# LAB_CHROMA_ASYNC_WRITE=1
# LAB_CHROMA_DEGRADED_OK=1

# --- Settings / forms (optional) ---
# LAB_USER_INSTRUCTIONS_MAX_CHARS=2500
# LAB_FORMS_PUBLIC_SUBMIT_MAX=60
# LAB_FORMS_PUBLIC_SUBMIT_WINDOW_MS=60000

# --- Smoke / ops (optional) ---
# SMOKE_SKIP_LAB_STACK=1
# SMOKE_ADMIN_USER=Admin
# SMOKE_ADMIN_PASSWORD=admin
# APP_SERVER_ALLOW_KILL=1
# CRM_SKIP_DEMO_SEED=1
